<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SmartEvent.Infrastructure.Integrations : servicios externos (correo SMTP y modelo de IA).

    Referencia a Core y a MailKit, nada mas. No conoce SQL Server ni Windows Forms: recibe
    entidades del dominio, habla con el mundo exterior y devuelve resultados. Los fallos de
    red, tiempo de espera o autenticacion se devuelven como DATOS, no como excepciones, para
    que un servidor caido nunca pueda tumbar una operacion de negocio ya confirmada.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>SmartEvent.Infrastructure.Integrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartEvent.Core\SmartEvent.Core.csproj" />
  </ItemGroup>

</Project>
